{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lunakitsune.vercel.app"
        }
      ],
      "destination": "https://hardikbhaskar.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/project/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|images|docs|videos|favicon|apple-touch-icon|icons|og-preview|google|site\\.webmanifest|robots\\.txt|sitemap\\.xml|llms\\.txt|ba4a24c6fef4406899d311af30c603fc\\.txt|.*?\\.(?:ico|png|svg|webp|jpg|jpeg|gif|pdf|txt|xml|json|webmanifest|html)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://www.clarity.ms https://scripts.clarity.ms https://cdnjs.cloudflare.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://raw.githubusercontent.com https://avatars.githubusercontent.com https://hardikbhaskar.vercel.app; connect-src 'self' https://api.github.com https://github-contributions-api.jogruber.de https://github-readme-stats-luna.vercel.app https://*.clarity.ms https://vitals.vercel-insights.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/(.*)\\.pdf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "Content-Language",
          "value": "en"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all, max-image-preview:large, max-snippet:-1"
        },
        {
          "key": "Content-Disposition",
          "value": "inline"
        }
      ]
    }
  ]
}
