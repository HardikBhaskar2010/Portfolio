{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lunakitsune.vercel.app"
        }
      ],
      "destination": "https://hardikbhaskar.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/project/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|images|favicon.svg|icons.svg|og-preview.png|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ]
}
