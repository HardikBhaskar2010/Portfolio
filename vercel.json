{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lunakitsune.vercel.app"
        }
      ],
      "destination": "https://hardikbhaskar.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/project/:slug",
      "destination": "/projects/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|images|docs|videos|favicon\\.svg|icons\\.svg|og-preview\\.png|og-preview\\.webp|robots\\.txt|sitemap\\.xml|llms\\.txt).*)",
      "destination": "/index.html"
    }
  ]
}
