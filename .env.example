# ─────────────────────────────────────────────────────────────
# Resend API Key — get yours at https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# SETUP STEPS:
# 1. Go to https://resend.com and create a free account
# 2. Copy your API key from https://resend.com/api-keys
# 3. Paste it above in this file, rename to .env.local
# 4. In Vercel dashboard → Project Settings → Environment Variables
#    add: RESEND_API_KEY = <your key>
#
# FREE TIER LIMITS (more than enough for a portfolio):
#   • 3,000 emails/month
#   • 100 emails/day
#
# NOTE: On free plan, "from" must be onboarding@resend.dev
#       To use your own domain (e.g. hi@lunakitsune.dev),
#       verify it at https://resend.com/domains
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# GitHub PAT — used by scripts/generate-projects.mjs to fetch
# repos tagged with "portfolio-project" at build time.
#
# Create a fine-grained PAT at https://github.com/settings/tokens
#   • Permissions: "Public Repositories" read-only (no write scopes)
#
# Add in three places:
#   1. Locally:        rename this file to .env.local and paste below
#   2. Vercel:         Project → Settings → Environment Variables
#   3. GitHub Actions: Repo → Settings → Secrets and variables → Actions
# ─────────────────────────────────────────────────────────────
PORTFOLIO_GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
